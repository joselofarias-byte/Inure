<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <app.simple.inure.decorations.theme.ThemeLinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/popup_padding">

        <app.simple.inure.decorations.theme.ThemeIcon
            android:id="@+id/terminal_icon"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/header_padding"
            android:transitionName="@string/terminal"
            app:srcCompat="@drawable/ic_terminal"
            app:tintType="accent"
            tools:ignore="ContentDescription" />

        <app.simple.inure.decorations.ripple.DynamicRippleTextView
            android:id="@+id/current_window"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:drawableEnd="@drawable/ic_arrow_drop_down_24dp"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:textSize="@dimen/popup_text_size"
            app:drawableTintStyle="secondary"
            app:textColorStyle="secondary" />

        <app.simple.inure.decorations.ripple.DynamicRippleImageButton
            android:id="@+id/add"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:clickable="false"
            android:src="@drawable/ic_add"
            app:buttonTintType="accent" />

        <app.simple.inure.decorations.ripple.DynamicRippleImageButton
            android:id="@+id/close"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:clickable="false"
            android:src="@drawable/ic_close"
            app:buttonTintType="accent" />

        <app.simple.inure.decorations.ripple.DynamicRippleImageButton
            android:id="@+id/options"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:clickable="false"
            android:src="@drawable/ic_more_vert"
            app:buttonTintType="accent" />

    </app.simple.inure.decorations.theme.ThemeLinearLayout>

    <app.simple.inure.decorations.theme.ThemeDivider
        android:layout_width="match_parent"
        android:layout_height="1px" />

    <app.simple.inure.terminal.TermViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <app.simple.inure.decorations.theme.ThemeDivider
        android:layout_width="match_parent"
        android:layout_height="1px" />

    <HorizontalScrollView
        android:id="@+id/extra_keys_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">

        <app.simple.inure.decorations.theme.ThemeLinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <app.simple.inure.decorations.ripple.DynamicRippleTextView
                android:id="@+id/key_esc"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:contentDescription="@string/term_key_esc"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="ESC"
                android:textSize="@dimen/popup_text_size"
                app:textColorStyle="primary" />

            <app.simple.inure.decorations.ripple.DynamicRippleTextView
                android:id="@+id/key_tab"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:contentDescription="@string/term_key_tab"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="TAB"
                android:textSize="@dimen/popup_text_size"
                app:textColorStyle="primary" />

            <app.simple.inure.decorations.ripple.DynamicRippleTextView
                android:id="@+id/key_ctrl"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:contentDescription="@string/term_key_ctrl"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="CTRL"
                android:textSize="@dimen/popup_text_size"
                app:textColorStyle="primary" />

            <app.simple.inure.decorations.ripple.DynamicRippleTextView
                android:id="@+id/key_alt"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:contentDescription="@string/term_key_alt"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="ALT"
                android:textSize="@dimen/popup_text_size"
                app:textColorStyle="primary" />

            <app.simple.inure.decorations.ripple.DynamicRippleTextView
                android:id="@+id/key_shift"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:contentDescription="@string/term_key_shift"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="SHIFT"
                android:textSize="@dimen/popup_text_size"
                app:textColorStyle="primary" />

            <app.simple.inure.decorations.ripple.DynamicRippleTextView
                android:id="@+id/key_left"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:contentDescription="@string/term_key_left"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="←"
                android:textSize="@dimen/popup_text_size"
                app:textColorStyle="primary" />

            <app.simple.inure.decorations.ripple.DynamicRippleTextView
                android:id="@+id/key_up"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:contentDescription="@string/term_key_up"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="↑"
                android:textSize="@dimen/popup_text_size"
                app:textColorStyle="primary" />

            <app.simple.inure.decorations.ripple.DynamicRippleTextView
                android:id="@+id/key_down"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:contentDescription="@string/term_key_down"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="↓"
                android:textSize="@dimen/popup_text_size"
                app:textColorStyle="primary" />

            <app.simple.inure.decorations.ripple.DynamicRippleTextView
                android:id="@+id/key_right"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_margin="2dp"
                android:contentDescription="@string/term_key_right"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="→"
                android:textSize="@dimen/popup_text_size"
                app:textColorStyle="primary" />

        </app.simple.inure.decorations.theme.ThemeLinearLayout>

    </HorizontalScrollView>

</LinearLayout>